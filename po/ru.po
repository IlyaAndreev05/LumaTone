msgstr "Режим тёплого цвета"
msgid "Black & white"
msgstr "Чёрно-белый"
msgid "Black-and-white color mode"
msgstr "Чёрно-белый режим"
msgid "Intensity"
msgstr "Интенсивность"
msgid "Color effect intensity"
msgstr "Интенсивность цветового эффекта"
msgid "No warming"
msgstr "Без потепления"
msgid "Normal colors"
msgstr "Обычные цвета"
msgid "Maximum warmth"
msgstr "Максимально тёплый"
msgid "Full black & white"
msgstr "Полностью чёрно-белый"
msgid "Contrast"
msgstr "Контрастность"
msgid "Contrast reduction"
msgstr "Снижение контрастности"
msgid "Normal contrast"
msgstr "Обычная контрастность"
msgid "Lower contrast"
msgstr "Меньше контрастности"
msgid "Warm colors"
msgstr "Тёплые цвета"
msgid "Off"
msgstr "Выключен"
msgid "Settings"
msgstr "Настройки"
msgid "LumaTone — Night mode"
msgstr "LumaTone — ночной режим"
msgid "Schedule"
msgstr "Расписание"
msgid "Choose the daily time when the color effect starts and ends."
msgstr "Выберите время включения и выключения цветового эффекта."
msgid "Automatic schedule"
msgstr "Включать по расписанию"
msgid "Start time"
msgstr "Время включения"
msgid "End time"
msgstr "Время выключения"
msgid "Start and end times must differ."
msgstr "Время включения и выключения должны различаться."
msgid "Enter both times in 24-hour HH:MM format."
msgstr "Введите оба времени в 24-часовом формате ЧЧ:ММ."
msgid "Use 24-hour local time (HH:MM). Intervals can pass midnight."
msgstr "Укажите местное время в формате ЧЧ:ММ. Интервал может проходить через полночь."
msgid "Behavior"
msgstr "Поведение"
msgid "Night Light GNOME"
msgstr "Ночной свет GNOME"
msgid "LumaTone pauses the built-in effect while this extension is enabled and restores its previous setting when disabled."
msgstr "LumaTone приостанавливает встроенный эффект на время работы расширения и восстанавливает его настройки после отключения."
